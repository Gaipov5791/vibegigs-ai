generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                String        @id
  email             String        @unique
  tech_stack        Json          @default("[]")
  stop_words        Json          @default("[]")
  bio               String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  selected_platform String        @default("We Work Remotely")
  analyzedJobs      AnalyzedJob[]
}

model RawJob {
  id           String        @id @default(cuid())
  title        String
  description  String
  budget       String?
  platform     String
  url          String        @unique
  status       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applyUrl     String?
  analyzedJobs AnalyzedJob[]
}

model AnalyzedJob {
  id                  String   @id @default(cuid())
  rawJobId            String
  match_percentage    Float
  ai_summary          String
  red_flags           Json
  cover_letter_expert String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tech_stack          Json
  estimatedDays       Int?
  estimatedPriceUsd   Int?
  userId              String
  direct_apply_link   String?
  rawJob              RawJob   @relation(fields: [rawJobId], references: [id], onDelete: Cascade)
  profile             Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rawJobId, userId])
}
